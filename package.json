{
  "name": "cv-location-api",
  "version": "1.0.0",
  "description": "Cape Verde locations lookup API (countries, islands, municipalities, parishes, zones, places)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx --watch --env-file .env src/main.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/src/main.js",
    "lint": "eslint src",
    "format": "prettier --write ./src",
    "lint:fix": "eslint src --fix",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file .env src/db/migrate.ts",
    "db:seed": "tsx --env-file .env src/scripts/seed.ts",
    "seeds:count": "tsx src/scripts/count-seeds.ts",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/error": "^4.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^5.0.3",
    "http-status-codes": "^2.3.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.13.13",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@eslint/js": "^9.23.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsc-alias": "^1.8.13",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  }
}
